# Required in production: the application refuses to start without a real, unique key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Development (DJANGO_DEBUG=True) may leave it unset.
DJANGO_SECRET_KEY=
# Never True in production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full web address of this site, e.g. https://erp.school.in. Used in links in WhatsApp messages; required before the school can choose WhatsApp sending.
PORTAL_BASE_URL=

# Leave DB_NAME unset to fall back to local SQLite for bootstrap/dev only.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
